---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/hero/Hero.astro';
import Projects from '@/components/projects/Projects.astro';
import Experience from '@/components/experience/Experience.astro';
import AiSection from '@/components/ai/AiSection.astro';
import ApprovalDemo from '@/components/approval/ApprovalDemo.astro';
import Skills from '@/components/skills/Skills.astro';
import Contact from '@/components/contact/Contact.astro';
import { getDictionary, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
---

<BaseLayout locale={locale}>
  <Hero hero={dict.hero} />
  <Projects projects={dict.projects} />
  <Experience experience={dict.experience} locale={locale} />
  <AiSection ai={dict.ai} />
  <ApprovalDemo approval={dict.approval} />
  <Skills skills={dict.skills} experience={dict.experience} />
  <Contact contact={dict.contact} terminal={dict.terminal} />
</BaseLayout>
