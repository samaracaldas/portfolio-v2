---
import { PERSON } from '@/content/shared/links';
import { localePath, LOCALES, type Locale, type SiteDict } from '@/i18n';

interface Props {
  locale: Locale;
  site: SiteDict;
}

const { locale, site } = Astro.props;
const base = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(localePath(locale), base).href;
const hreflang: Record<Locale, string> = { en: 'en', pt: 'pt-BR' };

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: PERSON.name,
  url: canonical,
  email: `mailto:${PERSON.email}`,
  sameAs: [PERSON.github, PERSON.linkedin],
  jobTitle: 'Full Stack Developer',
  knowsAbout: ['Angular', 'TypeScript', 'Node.js', 'MongoDB', 'Azure', 'Generative AI'],
  knowsLanguage: ['pt-BR', 'en'],
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidade Veiga de Almeida' },
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    name: 'Microsoft Certified: Azure Fundamentals (AZ-900)',
  },
};
---

<title>{site.meta.title}</title>
<meta name="description" content={site.meta.description} />
<meta name="author" content={PERSON.name} />
<link rel="canonical" href={canonical} />
{LOCALES.map((l) => <link rel="alternate" hreflang={hreflang[l]} href={new URL(localePath(l), base).href} />)}
<link rel="alternate" hreflang="x-default" href={new URL('/', base).href} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={PERSON.name} />
<meta property="og:title" content={site.meta.title} />
<meta property="og:description" content={site.meta.description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={site.ogLocale} />
<meta name="twitter:card" content="summary_large_image" />

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
