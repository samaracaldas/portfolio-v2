---
import LangToggle from './LangToggle.astro';
import { localePath, type Locale, type SiteDict } from '@/i18n';

interface Props {
  locale: Locale;
  site: SiteDict;
}

const { locale, site } = Astro.props;
---

<header class="header">
  <div class="header__inner container">
    <a class="header__logo mono" href={localePath(locale)}>
      sc<span class="accent" aria-hidden="true">.</span><span class="visually-hidden"> {site.a11y.home}</span>
    </a>
    <nav class="header__nav" aria-label={site.nav.label}>
      <ul role="list">
        {
          site.nav.items.map((item) => (
            <li>
              <a href={`#${item.id}`}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <LangToggle locale={locale} site={site} />
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    height: var(--header-h);
    background: rgb(10 10 10 / 0.72);
    backdrop-filter: blur(12px) saturate(1.2);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
    border-bottom: 1px solid rgb(255 255 255 / 0.04);
  }

  .header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .header__logo {
    font-weight: 700;
    font-size: var(--fs-md);
    text-decoration: none;
    letter-spacing: -0.03em;
  }

  .header__nav {
    margin-left: auto;
  }

  .header__nav ul {
    display: flex;
    gap: var(--space-5);
  }

  .header__nav a {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--c-muted);
    text-decoration: none;
  }

  .header__nav a:hover {
    color: var(--c-fg);
  }

  @media (max-width: 47.99rem) {
    .header__nav {
      display: none;
    }

    .header__inner > :last-child {
      margin-left: auto;
    }
  }
</style>
