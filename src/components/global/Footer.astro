---
import { PERSON } from '@/content/shared/links';
import type { SiteDict } from '@/i18n';

interface Props {
  site: SiteDict;
}

const { site } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner container mono">
    <p>© {year} {PERSON.name}</p>
    <p class="muted">
      {site.footer.builtWith} · <a href={PERSON.repo} rel="noopener">{site.footer.sourceLabel}</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: var(--z-content);
    border-top: 1px solid var(--c-line);
    padding-block: var(--space-6);
    font-size: var(--fs-xs);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
  }
</style>
