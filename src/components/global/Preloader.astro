---
import type { SiteDict } from '@/i18n';

interface Props {
  preloader: SiteDict['preloader'];
}

const { preloader } = Astro.props;
---

<!--
  Decorative build log shown on first paint (only with JS and motion allowed).
  lib/motion/preloader.ts drives it; a CSS failsafe hides it if JS never runs.
-->
<div class="preloader" aria-hidden="true" data-preloader>
  <div class="preloader__inner mono">
    <ol class="preloader__log" role="list">
      {preloader.lines.map((line) => <li data-preloader-line>{line}</li>)}
    </ol>
    <div class="preloader__row">
      <div class="preloader__bar"><span data-preloader-fill></span></div>
      <p class="preloader__count"><span data-preloader-count>0</span>%</p>
    </div>
    <p class="preloader__done" data-preloader-done>✓ {preloader.done}</p>
  </div>
</div>

<style>
  .preloader {
    display: none;
  }

  :global(html.js:not(.skip-preloader)) .preloader {
    position: fixed;
    inset: 0;
    z-index: var(--z-preloader);
    display: grid;
    place-items: end start;
    padding: var(--gutter);
    background: var(--c-bg);
    animation: preloader-failsafe 0s 7s forwards;
  }

  @keyframes preloader-failsafe {
    to {
      visibility: hidden;
      pointer-events: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .preloader {
      display: none;
    }
  }

  .preloader__inner {
    display: grid;
    gap: var(--space-4);
    width: min(100%, 34rem);
    font-size: var(--fs-sm);
    color: var(--c-muted);
  }

  .preloader__log {
    display: grid;
    gap: var(--space-1);
  }

  .preloader__log li {
    opacity: 0.2;
    transition: opacity var(--dur-fast) linear;
  }

  .preloader__log li:global(.is-done) {
    opacity: 1;
  }

  .preloader__log li:first-child {
    color: var(--c-fg);
  }

  .preloader__row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .preloader__bar {
    flex: 1;
    height: 2px;
    background: var(--c-line-strong);
    overflow: hidden;
  }

  .preloader__bar span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--c-accent);
    transform-origin: left;
    transform: scaleX(0);
  }

  .preloader__count {
    min-width: 4ch;
    text-align: right;
    font-size: var(--fs-xl);
    font-weight: 600;
    color: var(--c-fg);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.04em;
  }

  .preloader__done {
    color: var(--c-ok);
    opacity: 0;
  }
</style>
